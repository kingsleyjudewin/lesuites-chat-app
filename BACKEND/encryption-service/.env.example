# Must match node-backend/.env's ENCRYPTION_SERVICE_KEY exactly.
SERVICE_KEY=replace-with-shared-hmac-key-min-16-chars

# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY_B64=replace-with-base64-encoded-32-byte-key

ACTIVE_KEY_VERSION=v1
SIGNATURE_WINDOW_SECONDS=60
