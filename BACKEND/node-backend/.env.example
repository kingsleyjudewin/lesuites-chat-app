NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://mongo:27017/lesuits
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
CORS_ORIGIN=http://localhost:5173
COOKIE_SECRET=replace-with-a-long-random-secret

# Must match encryption-service/.env's SERVICE_KEY exactly.
ENCRYPTION_SERVICE_URL=http://encryption-service:8001
ENCRYPTION_SERVICE_KEY=replace-with-shared-hmac-key-min-16-chars

S3_BUCKET=lesuits-files
